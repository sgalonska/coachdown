{
  "name": "coachdown-obsidian",
  "version": "0.1.0",
  "description": "Coachdown for Obsidian: a dashboard of insights, decisions and open experiments across your coaching logs, plus the reference parser and a command-line tool.",
  "license": "MIT",
  "author": "Sebastian Galonska",
  "type": "module",
  "bin": { "coachdown": "dist/cli.cjs" },
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc -p tsconfig.json && node esbuild.config.mjs --production",
    "test": "npm run build && node --test test/parser.test.mjs",
    "install-plugin": "node scripts/install-plugin.mjs"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "esbuild": "0.24.0",
    "obsidian": "1.7.2",
    "typescript": "5.8.2"
  }
}
